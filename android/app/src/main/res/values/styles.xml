<resources>

    <!-- Base application theme. -->
    <!-- Edge-to-edge is enforced by the system on Android 15+ (targetSdk 35),
         so we inherit from react-native-edge-to-edge's theme instead of
         Theme.AppCompat.DayNight.NoActionBar directly. -->
    <style name="AppTheme" parent="Theme.EdgeToEdge">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Moozy is a fully transparent, gesture-nav-friendly bottom bar (mini player) -->
        <item name="enforceNavigationBarContrast">false</item>
    </style>

</resources>
